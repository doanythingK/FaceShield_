# Generated native dependencies
# Windows FFmpeg DLLs are extracted from FFmpeg/win-x64-binaries.tar.gz.
FFmpeg/win-x64/
# macOS FFmpeg dylibs are generated by scripts/prepare-ffmpeg-osx.sh.
FFmpeg/osx-arm64/
FFmpeg/osx-x64/

# Compiled native/application binaries should not be added ad-hoc.
# Existing explicitly tracked source bundles/fallback files remain tracked by Git.
*.dll
*.exe
*.so
*.dylib

# Package/tool caches
packages/
.paket/
.fake/
_ReSharper*/
*.DotSettings.user
